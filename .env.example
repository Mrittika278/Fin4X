# =====================================================================
# Fin4X Environment Configuration
# =====================================================================
# Note: Fin4X works 100% out-of-the-box with built-in realistic simulated 
# fallbacks if these optional API keys are omitted.

# Groq API Key (Optional: Required only for Fin4X AI Quant Assistant)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# SerpApi Key (Optional: Required only for live Google News headlines)
# Get a free key at: https://serpapi.com/google-news-api
SERPAPI_API_KEY=your_serpapi_api_key_here

# Server Settings
HOST=0.0.0.0
PORT=8000
